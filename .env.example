# Copy to `.env` for local development (never commit `.env`)

NEXT_PUBLIC_API_BASE_URL=https://lendapitest.persiansys.ir/api/v1
NEXT_PUBLIC_API_REPORT_URL=https://lendreporttest.persiansys.ir/api/v1

NEXT_PUBLIC_QUERY_GC_TIME=0
NEXT_PUBLIC_QUERY_STALE_TIME=0
NEXT_PUBLIC_QUERY_RETRY=1

